# Copiá a .env (local) o cargá estas variables en Dokploy
DATABASE_URL=postgres://postgres:postgres@localhost:5432/libreria
PORT=3001
# Llave para cifrar secretos guardados (clave de la IA, VAPID). Obligatoria en producción; no la cambies después.
APP_SECRET=cambiar-por-un-texto-largo-y-aleatorio
# URL pública del sitio (enlaces de pago y correos)
PUBLIC_URL=https://tu-dominio.com
# En contenedores el HTTPS lo hace el proxy (Traefik): 0 desactiva el HTTPS propio
HTTPS_PORT=0
