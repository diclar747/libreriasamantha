{
  "id": "/admin",
  "name": "Samantha — Gestión",
  "short_name": "Samantha",
  "description": "Ventas, inventario, caja y pedidos de Samantha — Libros y regalos.",
  "lang": "es-PY",
  "dir": "ltr",
  "start_url": "/admin?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#12163f",
  "theme_color": "#12163f",
  "categories": ["business", "productivity"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [
    { "src": "/screenshots/admin-wide.webp", "sizes": "1280x720", "type": "image/webp", "form_factor": "wide", "label": "Panel con ventas e indicadores" },
    { "src": "/screenshots/admin-narrow.webp", "sizes": "780x1688", "type": "image/webp", "form_factor": "narrow", "label": "Panel en el teléfono" }
  ],
  "shortcuts": [
    { "name": "Punto de venta", "short_name": "Vender", "url": "/pos?source=shortcut", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Pedidos en línea", "short_name": "Pedidos", "url": "/orders?source=shortcut", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Caja", "short_name": "Caja", "url": "/cash?source=shortcut", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Productos", "short_name": "Productos", "url": "/products?source=shortcut", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
